{
  "name": "My Virtual Library (Node 22)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [
    1420
  ],
  "portsAttributes": {
    "1420": {
      "label": "Virtual Library development preview",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "PUPPETEER_SKIP_DOWNLOAD=1 npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
